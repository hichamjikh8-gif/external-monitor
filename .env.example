# URL to monitor
TARGET_URL=https://souss-actualites.com

# Monitoring behaviour
CHECK_INTERVAL=60
FAIL_THRESHOLD=3
REQUEST_TIMEOUT=15

# Email alerts (required)
ALERT_EMAIL=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SENDER_NAME=Site Monitor

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Railway self-heal (optional)
RAILWAY_API_TOKEN=
RAILWAY_SERVICE_ID=
RAILWAY_ENV_ID=
